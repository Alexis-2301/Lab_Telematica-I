{
  "info": {
    "name": "RabbitMQ Lab",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "guest",
        "type": "string"
      },
      {
        "key": "password",
        "value": "guest",
        "type": "string"
      }
